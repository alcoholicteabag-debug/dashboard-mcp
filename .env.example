# Environment template — copy to .env.local and fill in your Supabase credentials

# Supabase (get from https://app.supabase.com/project/[project-id]/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Server
PORT=3000
NODE_ENV=development

# Optional: Chrome automation (for screenshots)
CHROME_WS_ENDPOINT=ws://localhost:3000

# Optional: Cloudflare Tunnel (for mobile sync)
TUNNEL_URL=https://your-tunnel.trycloudflare.com
